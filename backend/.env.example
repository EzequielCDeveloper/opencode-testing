# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ── Database (use DATABASE_URL OR individual vars) ─────────────────────────────
DATABASE_URL=postgres://chapitos:chapitos@localhost:5432/chapitos_db?sslmode=disable
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=chapitos
# DB_PASSWORD=chapitos
# DB_NAME=chapitos_db

# ── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_HOURS=14

# ── Email (SMTP / Gmail) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@chapitosgym.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Chapitos Gym <no-reply@chapitosgym.com>
